rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower() == 'agentenorvingarcia@gmail.com';
    }

    match /propiedades/{propertyId}/{mediaFolder}/{fileName} {
      allow read: if true;
      allow write: if isAllowedAdmin()
        && propertyId.size() > 0
        && (mediaFolder == 'imagenes' || mediaFolder == 'videos')
        && fileName.size() > 0;
    }

    match /agentes/{fileName} {
      allow read: if true;
      allow write: if isAllowedAdmin() && fileName.size() > 0;
    }

    match /listado/{id}/{allPaths=**} {
      allow read, write: if isAllowedAdmin();
    }

    match /avaluos/{avaluoId}/{allPaths=**} {
      allow read, write: if isAllowedAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
